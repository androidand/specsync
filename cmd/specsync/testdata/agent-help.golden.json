{
  "commands": [
    "adopt",
    "archive",
    "audit",
    "audit-tasks",
    "changelog",
    "changes",
    "doctor",
    "epic",
    "idea",
    "ideas",
    "install-skill",
    "link",
    "note",
    "pr-body",
    "pull",
    "release-plan",
    "scan",
    "set-priority",
    "set-stage",
    "spinoff",
    "sync",
    "trace",
    "validate",
    "verify"
  ],
  "help": {
    "adopt": {
      "command": "adopt",
      "description": "Bind an existing local change to an existing tracker issue, when neither one knows about the other.",
      "mutates": true,
      "workflow": {
        "position": "plan",
        "related_before": [
          "changes",
          "scan"
        ],
        "related_after": [
          "sync"
        ]
      },
      "flags": [
        {
          "name": "issue",
          "type": "number",
          "required": true,
          "description": "Issue number to bind the change to (required)"
        },
        {
          "name": "change",
          "type": "string",
          "required": false,
          "description": "Change slug (default: derived from the current branch name, e.g. feat/42-change)"
        },
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Preview what would be written without writing anything"
        },
        {
          "name": "force",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Rebind despite an existing, conflicting binding on either side"
        },
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "auto-detect",
          "description": "Target repo as owner/name"
        }
      ],
      "safety_rules": [
        "Never hand-edit the marker into an issue body and hope the next sync finds it — marker discovery goes through search indexing, which lags writes by seconds to minutes, and a sync inside that window creates a duplicate issue instead. Use adopt: it writes the ref cache before touching the issue body, so the link holds immediately.",
        "Use -dry-run to preview before adopting",
        "A change already bound to a different issue, or an issue already marked for a different change, is refused without -force"
      ],
      "examples": [
        "specsync adopt -issue 3691 -dry-run",
        "specsync adopt -issue 3691 -change my-change",
        "specsync adopt -issue 3691 -change my-change -force"
      ]
    },
    "archive": {
      "command": "archive",
      "description": "Archive a completed change: final push, close, then retention.",
      "mutates": true,
      "workflow": {
        "position": "after-complete",
        "related_before": [
          "changes",
          "sync"
        ],
        "related_after": [
          "verify"
        ]
      },
      "flags": [
        {
          "name": "change",
          "type": "string",
          "required": true,
          "description": "Change to archive"
        },
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "auto-detect",
          "description": "Target repo as owner/name"
        },
        {
          "name": "retain",
          "type": "string",
          "required": false,
          "description": "Retention policy: move (keep) or prune (delete)"
        },
        {
          "name": "force",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Archive even when tasks are unchecked"
        },
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Print the plan without making changes"
        }
      ],
      "safety_rules": [
        "Use -dry-run to preview before archiving",
        "Refuses unchecked-task changes unless -force is set"
      ],
      "examples": [
        "specsync archive -change my-change -dry-run",
        "specsync archive -change my-change -retain move"
      ]
    },
    "audit": {
      "command": "audit",
      "description": "Audit OpenSpec changes for structural issues.",
      "mutates": false,
      "workflow": {
        "position": "validation"
      },
      "flags": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "Read-only operation"
      ],
      "examples": [
        "specsync audit",
        "specsync audit -json"
      ]
    },
    "audit-tasks": {
      "command": "audit-tasks",
      "description": "Audit that task status matches code changes (dogfooding).",
      "mutates": false,
      "workflow": {
        "position": "validation"
      },
      "flags": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "Enforced by CI",
        "Keeps this repo's dogfooding honest"
      ],
      "examples": [
        "specsync audit-tasks",
        "specsync audit-tasks -json"
      ]
    },
    "changelog": {
      "command": "changelog",
      "description": "Generate release notes from OpenSpec changes and commits.",
      "mutates": false,
      "workflow": {
        "position": "release",
        "related_before": [
          "release-plan"
        ]
      },
      "flags": [
        {
          "name": "resolve-refs",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Resolve issue references in commits"
        }
      ],
      "safety_rules": [
        "Read-only operation",
        "Requires git history"
      ],
      "examples": [
        "specsync changelog",
        "specsync changelog -resolve-refs"
      ]
    },
    "changes": {
      "command": "changes",
      "description": "List all OpenSpec changes with status.",
      "mutates": false,
      "workflow": {
        "position": "planning",
        "related_after": [
          "pull",
          "scan",
          "link"
        ]
      },
      "flags": [
        {
          "name": "stage",
          "type": "string",
          "required": false,
          "description": "Filter by stage (backlog, active, blocked, in-review, complete, archived)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "Read-only operation"
      ],
      "examples": [
        "specsync changes",
        "specsync changes --stage backlog",
        "specsync changes -json"
      ]
    },
    "doctor": {
      "command": "doctor",
      "description": "Diagnose skill installation, environment, and context health.",
      "mutates": false,
      "workflow": {
        "position": "anytime",
        "related_after": [
          "install-skill"
        ]
      },
      "flags": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        },
        {
          "name": "skip-skill-update",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Skip auto-updating skill files before diagnosing"
        }
      ],
      "safety_rules": [
        "Read-only operation"
      ],
      "examples": [
        "specsync doctor",
        "specsync doctor install -json",
        "specsync doctor context -json"
      ]
    },
    "epic": {
      "command": "epic",
      "description": "Create a coordination issue and wire children to it.",
      "mutates": true,
      "workflow": {
        "position": "plan",
        "related_before": [
          "changes"
        ],
        "related_after": [
          "sync"
        ]
      },
      "flags": [
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "auto-detect",
          "description": "Target repo for the epic issue, as owner/name"
        },
        {
          "name": "child",
          "type": "string",
          "required": false,
          "description": "A child to attach: local change slug, owner/repo#N, bare #N, or issue URL (repeatable)"
        },
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Print what would happen without creating or editing any issue"
        }
      ],
      "safety_rules": [
        "Use -dry-run to preview before creating or editing issues",
        "Re-running with the same title converges onto the existing epic instead of duplicating it"
      ],
      "examples": [
        "specsync epic 'Q3 auth rework' --child my-change --child other-org/other-repo#42 --dry-run",
        "specsync epic 'Q3 auth rework' --child my-change"
      ]
    },
    "idea": {
      "command": "idea",
      "description": "Capture a free-text idea as a stage:intake issue.",
      "mutates": true,
      "workflow": {
        "position": "capture",
        "related_after": [
          "ideas",
          "pull"
        ]
      },
      "flags": [
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "config ideas_repo, $SPECSYNC_IDEAS_REPO, or current repo",
          "description": "Repo to create the idea issue in, as owner/name"
        }
      ],
      "safety_rules": [
        "Creates a real GitHub issue — there is no -dry-run"
      ],
      "examples": [
        "specsync idea 'Consider caching the trace graph'",
        "echo 'Consider caching the trace graph' | specsync idea"
      ]
    },
    "ideas": {
      "command": "ideas",
      "description": "List open stage:intake issues for the repo.",
      "mutates": false,
      "workflow": {
        "position": "review",
        "related_after": [
          "pull"
        ]
      },
      "flags": [
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "config ideas_repo, $SPECSYNC_IDEAS_REPO, or current repo",
          "description": "Repo to list idea issues from, as owner/name"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "Read-only operation"
      ],
      "examples": [
        "specsync ideas",
        "specsync ideas -json"
      ]
    },
    "install-skill": {
      "command": "install-skill",
      "description": "Install the SpecSync Claude Code skill.",
      "mutates": true,
      "workflow": {
        "position": "setup"
      },
      "flags": [
        {
          "name": "claude-code",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Install for Claude Code"
        },
        {
          "name": "all",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Install for all supported agents"
        },
        {
          "name": "profile",
          "type": "string",
          "required": false,
          "default": "minimal",
          "description": "Installation profile (minimal, docs, full)"
        }
      ],
      "safety_rules": [
        "Requires write access to ~/.claude/ or similar"
      ],
      "examples": [
        "specsync install-skill --claude-code",
        "specsync install-skill --all --profile minimal",
        "specsync install-skill --claude-code --profile docs"
      ]
    },
    "link": {
      "command": "link",
      "description": "Cross-link two or more OpenSpec changes.",
      "mutates": true,
      "workflow": {
        "position": "plan",
        "related_before": [
          "scan",
          "changes"
        ],
        "related_after": [
          "sync"
        ]
      },
      "flags": [
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Preview links without writing files"
        }
      ],
      "safety_rules": [
        "At least 2 changes required",
        "Use -dry-run to preview",
        "Links are append-only (existing links not removed)"
      ],
      "examples": [
        "specsync link my-change other-change -dry-run",
        "specsync link my-change other-change",
        "specsync link change-a change-b change-c"
      ]
    },
    "note": {
      "command": "note",
      "description": "Append a discovery line to a change's discoveries.md.",
      "mutates": true,
      "workflow": {
        "position": "implementation",
        "related_after": [
          "spinoff"
        ]
      },
      "flags": [
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "show what would be written without modifying files"
        },
        {
          "name": "openspec",
          "type": "string",
          "required": false,
          "default": "openspec",
          "description": "path to the openspec/ directory"
        },
        {
          "name": "store",
          "type": "string",
          "required": false,
          "default": "",
          "description": "registered OpenSpec store id to operate on (default: openspec/config.yaml `store:`, else ./openspec)"
        }
      ],
      "safety_rules": [
        "Takes positional args: \u003cchange\u003e \u003ctext\u003e, not a -text flag"
      ],
      "examples": [
        "specsync note my-change 'Found edge case in X' -dry-run",
        "specsync note my-change 'Found edge case in X'"
      ]
    },
    "pr-body": {
      "command": "pr-body",
      "description": "Generate the correct PR body fragment for a change.",
      "mutates": false,
      "workflow": {
        "position": "implementation",
        "related_before": [
          "changes"
        ]
      },
      "flags": [
        {
          "name": "change",
          "type": "string",
          "required": true,
          "description": "Change slug"
        }
      ],
      "safety_rules": [
        "Always include the output in your PR body",
        "Part of or Closes depends on task completion"
      ],
      "examples": [
        "specsync pr-body -change my-change"
      ]
    },
    "pull": {
      "command": "pull",
      "description": "Pull an issue into a local OpenSpec change.",
      "mutates": true,
      "workflow": {
        "position": "issue-first-start",
        "related_before": [
          "changes",
          "scan"
        ],
        "related_after": [
          "sync",
          "link"
        ]
      },
      "flags": [
        {
          "name": "issue",
          "type": "number",
          "required": true,
          "description": "Issue number to pull (required)"
        },
        {
          "name": "change",
          "type": "string",
          "required": false,
          "description": "Override auto-derived change slug"
        },
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Preview what would be written without touching disk"
        },
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "auto-detect",
          "description": "Target repo as owner/name"
        },
        {
          "name": "worktree",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Create (or reuse) a git worktree for this issue and run the pull inside it, instead of the current directory — one issue, one branch, one worktree"
        },
        {
          "name": "worktree-dir",
          "type": "string",
          "required": false,
          "default": "../worktrees (or $SPECSYNC_WORKTREE_DIR)",
          "description": "Base directory for -worktree"
        }
      ],
      "safety_rules": [
        "Use -dry-run to preview before pulling",
        "Verify the issue number is correct",
        "Work each issue in its own branch (feat/\u003cn\u003e-\u003cslug\u003e) and, ideally, its own worktree — pass -worktree to have pull set both up automatically, rather than accumulating unrelated changes on whatever branch happens to be checked out"
      ],
      "examples": [
        "specsync pull -issue 42 -dry-run",
        "specsync pull -issue 42",
        "specsync pull -issue 42 -json"
      ]
    },
    "release-plan": {
      "command": "release-plan",
      "description": "Inspect release impact and generate release notes.",
      "mutates": false,
      "workflow": {
        "position": "release",
        "related_before": [
          "changelog"
        ]
      },
      "flags": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        },
        {
          "name": "since",
          "type": "string",
          "required": false,
          "description": "Git reference for start of range (e.g., v0.9.0)"
        },
        {
          "name": "until",
          "type": "string",
          "required": false,
          "description": "Git reference for end of range (default: main)"
        }
      ],
      "safety_rules": [
        "Read-only operation"
      ],
      "examples": [
        "specsync release-plan",
        "specsync release-plan --since v0.9.0",
        "specsync release-plan -json"
      ]
    },
    "scan": {
      "command": "scan",
      "description": "Scan for existing work in a code area or topic.",
      "mutates": false,
      "workflow": {
        "position": "plan",
        "related_before": [
          "changes"
        ],
        "related_after": [
          "pull",
          "link"
        ]
      },
      "flags": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "At least one path or topic word is required",
        "Flags must come before positional arguments"
      ],
      "examples": [
        "specsync scan cmd/specsync/ 'label creation'",
        "specsync scan cmd/specsync/ -json",
        "specsync scan openspec/changes/ reconcile"
      ]
    },
    "set-priority": {
      "command": "set-priority",
      "description": "Set or unset a change's numeric priority override.",
      "mutates": true,
      "workflow": {
        "position": "plan",
        "related_before": [
          "changes"
        ],
        "related_after": [
          "changes"
        ]
      },
      "flags": [
        {
          "name": "openspec",
          "type": "string",
          "required": false,
          "default": "openspec",
          "description": "Path to the openspec/ directory"
        }
      ],
      "safety_rules": [
        "Takes positional args: \u003cchange\u003e \u003c1-100|unset\u003e, not flags"
      ],
      "examples": [
        "specsync set-priority my-change 80",
        "specsync set-priority my-change unset"
      ]
    },
    "set-stage": {
      "command": "set-stage",
      "description": "Set the workflow stage of a change.",
      "mutates": true,
      "workflow": {
        "position": "workflow",
        "related_before": [
          "changes"
        ],
        "related_after": [
          "sync"
        ]
      },
      "flags": [
        {
          "name": "stage",
          "type": "string",
          "required": true,
          "description": "New stage (backlog, active, blocked, in-review, complete, archived, auto)"
        }
      ],
      "safety_rules": [
        "Use 'auto' to let specsync derive stage from tasks"
      ],
      "examples": [
        "specsync set-stage my-change active",
        "specsync set-stage my-change blocked",
        "specsync set-stage my-change complete"
      ]
    },
    "spinoff": {
      "command": "spinoff",
      "description": "Spin off emergent work from a discovery.",
      "mutates": true,
      "workflow": {
        "position": "implementation",
        "related_before": [
          "changes"
        ],
        "related_after": [
          "sync",
          "link"
        ]
      },
      "flags": [
        {
          "name": "from",
          "type": "string",
          "required": true,
          "description": "Parent change slug"
        },
        {
          "name": "task",
          "type": "number",
          "required": false,
          "description": "Task number to extract and mark as moved"
        },
        {
          "name": "text",
          "type": "string",
          "required": false,
          "description": "Free-form discovery text"
        },
        {
          "name": "kind",
          "type": "string",
          "required": false,
          "description": "Label kind (bug, followup, task)"
        }
      ],
      "safety_rules": [
        "Either -task or -text required",
        "Creates a new change locally",
        "Link the changes with specsync link after"
      ],
      "examples": [
        "specsync spinoff -from my-change -task 3",
        "specsync spinoff -from my-change -text 'Found edge case in X'"
      ]
    },
    "sync": {
      "command": "sync",
      "description": "Synchronize an OpenSpec change with GitHub Issues.",
      "mutates": true,
      "workflow": {
        "position": "after-implementation",
        "related_before": [
          "scan",
          "pull",
          "changes"
        ],
        "related_after": [
          "changes",
          "verify",
          "release-plan"
        ]
      },
      "flags": [
        {
          "name": "change",
          "type": "string",
          "required": false,
          "default": "",
          "description": "Sync only this change; without it, syncs every change"
        },
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Preview the sync without writing to GitHub"
        },
        {
          "name": "reconcile",
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Merge task state from GitHub back into tasks.md"
        },
        {
          "name": "close-completed",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Auto-close the issue when all tasks are checked"
        },
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "auto-detect",
          "description": "Target repo as owner/name (default: auto-detect from git remote)"
        }
      ],
      "safety_rules": [
        "Always use -dry-run first to preview changes",
        "Always pass -change when one change is in scope (without it, syncs every change)",
        "Confirm git remote points to the right repo"
      ],
      "examples": [
        "specsync -dry-run -change my-change",
        "specsync -change my-change",
        "specsync sync -json -change my-change"
      ]
    },
    "trace": {
      "command": "trace",
      "description": "Trace dependencies and relationships of a change.",
      "mutates": false,
      "workflow": {
        "position": "debugging",
        "related_before": [
          "changes"
        ]
      },
      "flags": [
        {
          "name": "change",
          "type": "string",
          "required": false,
          "description": "Trace only this change (default: all)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "Read-only operation"
      ],
      "examples": [
        "specsync trace",
        "specsync trace -change my-change",
        "specsync trace -json"
      ]
    },
    "validate": {
      "command": "validate",
      "description": "Validate OpenSpec change structure.",
      "mutates": false,
      "workflow": {
        "position": "validation"
      },
      "flags": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Emit machine-readable JSON output"
        }
      ],
      "safety_rules": [
        "Read-only operation",
        "Run before syncing"
      ],
      "examples": [
        "specsync validate",
        "specsync validate -json"
      ]
    },
    "verify": {
      "command": "verify",
      "description": "Verify PR references to their change issues.",
      "mutates": false,
      "workflow": {
        "position": "pre-merge",
        "related_before": [
          "pr-body"
        ]
      },
      "flags": [],
      "safety_rules": [
        "Run before merging a PR",
        "All open PRs should have issue references"
      ],
      "examples": [
        "specsync verify"
      ]
    }
  }
}
